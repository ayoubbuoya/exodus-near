# Exodus Backend Configuration

# PostgreSQL database connection URL
DATABASE_URL=postgres://postgres:postgres@localhost:5432/exodus

# Network & RPC
NEAR_NETWORK=testnet
NEAR_RPC_URL=https://test.rpc.fastnear.com

# Comma-separated list of market contract account IDs to monitor
MARKET_CONTRACTS=market.fond-buoya.testnet

# Server Port
PORT=3001

# NEAR Intents (1Click) API
ONECLICK_API_URL=https://1click.chaindefuser.com/v0
ONECLICK_API_KEY=

# Optional: Keeper credentials (if not set, keeper logs warnings but does not submit transactions)
KEEPER_ACCOUNT_ID=
KEEPER_PRIVATE_KEY=

# Indexer polling interval in seconds
POLL_INTERVAL_SECS=60
