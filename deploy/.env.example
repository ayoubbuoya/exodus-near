# Exodus on NEAR: VPS environment
# Copy to deploy/.env on the server, fill it in, then: chmod 600 deploy/.env
# deploy/.env is git-ignored. Never commit it.

# --- Database ---------------------------------------------------------------
# Use hex only (no @ : / ? #), because it is placed inside DATABASE_URL.
# Generate with: openssl rand -hex 24
POSTGRES_PASSWORD=

# --- Docker networking ------------------------------------------------------
# Existing network the nginx container is on (see `docker network ls`).
PROXY_NETWORK=exodus-prod_default

# --- NEAR -------------------------------------------------------------------
NEAR_NETWORK=testnet
NEAR_RPC_URL=https://test.rpc.fastnear.com
# Comma-separated market contract accounts to index
MARKET_CONTRACTS=demo-market.fond-buoya.testnet,linear-market.fond-buoya.testnet
POLL_INTERVAL_SECS=60

# --- NEAR Intents (1Click) --------------------------------------------------
ONECLICK_API_URL=https://1click.chaindefuser.com/v0
ONECLICK_API_KEY=

# --- Keeper -----------------------------------------------------------------
# Leave both empty: the keeper does not sign transactions yet
# (NearRpcClient::call_refresh_index is a stub), so a key here is never used.
KEEPER_ACCOUNT_ID=
KEEPER_PRIVATE_KEY=

# --- Logging ----------------------------------------------------------------
RUST_LOG=backend=info,tower_http=info
